[Unit]
Description=Hospital Mock IoT HTTP Service (Server 3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hospital-mock-iot
ExecStart=/usr/bin/python3 -m http.server 8080 --bind {{ global_settings.dhcp_server_ip }}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
